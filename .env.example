# Copiar a .env y rellenar. El .env NO se commitea.

# --- Acceso (obligatorio) ---
# Sin BASIC_AUTH_PASSWORD el contenedor se niega a arrancar: el arbol tiene
# datos de personas vivas y no debe quedar nunca abierto por descuido.
BASIC_AUTH_USER=familia
BASIC_AUTH_PASSWORD=

# --- Contenido ---
SITE_TITLE=Arbol familiar Robson
# Nombre del fichero dentro del volumen /data
GEDCOM_FILE=arbol-robson.ged
# Persona que se muestra al entrar sin enlace directo. Vacio = la mas antigua.
DEFAULT_PERSON_ID=

# --- Privacidad ---
# Oculta fechas, lugares y notas de quien no tiene defuncion registrada y
# nacio despues del ano de corte. Solo queda visible el nombre.
PRIVACY_MODE=true
PRIVACY_BIRTH_YEAR_CUTOFF=1930
# true = ocultar tambien a quien no tiene ninguna fecha (mas seguro, mas
# restrictivo: en este arbol son unas 795 personas).
PRIVACY_HIDE_UNDATED=false

# --- Rendimiento ---
# Generaciones que se dibujan hacia arriba y hacia abajo por defecto.
DEFAULT_GENERATIONS=4
# Tope duro de personas por dibujo. Subirlo penaliza sobre todo al movil.
MAX_NODES=400

# --- Local ---
HOST_PORT=8080
